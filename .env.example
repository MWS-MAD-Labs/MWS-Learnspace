APP_URL=http://localhost:3000
PORT=4000
API_PORT=4000
VITE_API_PROXY_TARGET=http://localhost:4000
DATABASE_URL=postgresql://learnspace:change-me@db:5432/learnspace
POSTGRES_DB=learnspace
POSTGRES_USER=learnspace
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
SESSION_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=development-placeholder
GOOGLE_CLIENT_SECRET=development-placeholder
GOOGLE_ALLOWED_DOMAINS=example.org
ALLOW_DEVELOPMENT_AUTH_PLACEHOLDERS=true
LOG_LEVEL=info

GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
AUTH_ADMISSION_MODE=DENY_UNKNOWN
SESSION_TTL_HOURS=24

# Shared Hub session mode. Local development can use shared; keep Google OAuth
# and PostgreSQL session settings until the rollback window closes.
# off | shadow | shared
SHARED_SESSION_MODE=shared
# HUB_BASE_URL=https://app.mws.web.id
# HUB_ACCESS_COOKIE_NAME=hub_at
# CENTRAL_API_BASE_URL=https://db.mws.web.id/api/internal
# CENTRAL_API_TOKEN=central-api-token
# CENTRAL_ORGANIZATION_ID=central-organization-id
# HUB_SSO_APP_ID=learnspace # Canonical application ID.
# CENTRAL_APPLICATION_ID=learnspace # Legacy alias; startup fails if both values conflict.
# SHARED_SESSION_LOCAL_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000 # Optional one-time mapping hint.
# CENTRAL_API_TIMEOUT_MS=5000
# SHARED_SESSION_ENTITLEMENT_CACHE_SECONDS=30 # Positive valid entitlements only.
# SHARED_SESSION_LOG_MATCHES=false
# CENTRAL_SYNC_INTERVAL_MINUTES=0 # Minutes between the Central access and academic sync inside the API (shared mode). 0 keeps it off; 15 is a good start.
