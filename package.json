{
  "name": "learnspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.20.2",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "dev": "npm run dev -w @learnspace/web",
    "dev:api": "npm run dev -w @learnspace/api",
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf apps/*/dist packages/*/dist coverage server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present -- --run"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.0"
  }
}
