{
  "name": "learnspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "postinstall": "bun scripts/build-central-auth.ts",
    "dev": "bun run --filter @learnspace/web dev",
    "dev:api": "bun run --filter @learnspace/api dev",
    "build": "bun run --workspaces --if-present build",
    "clean": "rm -rf apps/*/dist packages/*/dist coverage server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "lint:anti-slop": "oxlint . --quiet -A correctness -A react/rules-of-hooks -A react/jsx-no-duplicate-props -A no-unused-vars -D oxc/no-accumulating-spread -D anti-slop/no-reduce-accumulator-copy -D anti-slop/no-reflect-apply -D anti-slop/no-reflect-get -D anti-slop/no-unknown-type-aliases -D anti-slop/no-widen-then-assert",
    "pretypecheck": "bun run --filter @learnspace/contracts build",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/contracts/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "bun run --filter @learnspace/api test && bun run --filter @learnspace/web test",
    "test:integration:local": "sh scripts/test-integration-local.sh",
    "prisma:validate": "bun run --filter @learnspace/api prisma:validate",
    "prisma:generate": "bun run --filter @learnspace/api prisma:generate",
    "db:migrate:dev": "bun run --filter @learnspace/api db:migrate:dev --",
    "db:migrate:deploy": "bun run --filter @learnspace/api db:migrate:deploy",
    "db:migrate:status": "bun run --filter @learnspace/api db:migrate:status",
    "db:seed": "bun run --filter @learnspace/api db:seed",
    "e2e:attendance:start": "docker compose -p learnspace-attendance-e2e -f compose.e2e.yaml up --build --wait --wait-timeout 240",
    "e2e:attendance:test": "playwright test --project=attendance-chromium",
    "e2e:attendance:stop": "docker compose -p learnspace-attendance-e2e -f compose.e2e.yaml down --volumes --remove-orphans",
    "e2e:attendance": "sh scripts/e2e-attendance.sh",
    "e2e:p5:start": "docker compose -p learnspace-p5-e2e -f compose.e2e.yaml up --build --wait --wait-timeout 240",
    "e2e:p5:test": "playwright test --project=p5-administration-chromium --project=p5-learning-journeys-chromium --project=p5-observations-chromium --project=p5-ieps-chromium --project=p5-weekly-reports-chromium",
    "e2e:p5:ieps:test": "playwright test --project=p5-ieps-chromium",
    "e2e:p5:weekly-reports:test": "playwright test --project=p5-weekly-reports-chromium",
    "e2e:p5:stop": "docker compose -p learnspace-p5-e2e -f compose.e2e.yaml down --volumes --remove-orphans",
    "e2e:p5": "sh scripts/e2e-p5.sh",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore": "sh scripts/db-restore.sh",
    "openapi:generate": "bun run --filter @learnspace/api openapi:generate",
    "openapi:check": "bun run --filter @learnspace/api openapi:check",
    "db:import": "bun run --filter @learnspace/api db:import --",
    "db:import:prepare-local": "bun scripts/prepare-local-import-rehearsal.ts",
    "db:backfill-central-principals": "bun run --filter @learnspace/api db:backfill-central-principals --",
    "central-access:sync": "bun run --filter @learnspace/api central-access:sync --",
    "permissions:check": "bun run --filter @learnspace/api permissions:check --",
    "permissions:sync": "bun run --filter @learnspace/api permissions:sync --",
    "shared-session:readiness": "bun run --filter @learnspace/api shared-session:readiness --"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "framer-motion": "13.5.1",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prisma": "6.12.0",
    "tsup": "8.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@prisma/client": "6.12.0"
  }
}
