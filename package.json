{
  "name": "learnspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.20.2",
    "npm": ">=10.8.2"
  },
  "scripts": {
    "dev": "npm run dev -w @learnspace/web",
    "dev:api": "npm run dev -w @learnspace/api",
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf apps/*/dist packages/*/dist coverage server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present -- --run",
    "prisma:validate": "npm run prisma:validate -w @learnspace/api",
    "prisma:generate": "npm run prisma:generate -w @learnspace/api",
    "db:migrate:dev": "npm run db:migrate:dev -w @learnspace/api --",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @learnspace/api",
    "db:migrate:status": "npm run db:migrate:status -w @learnspace/api",
    "db:seed": "npm run db:seed -w @learnspace/api",
    "e2e:attendance:start": "docker compose -p learnspace-attendance-e2e -f compose.e2e.yaml up --build --wait --wait-timeout 240",
    "e2e:attendance:test": "playwright test --project=attendance-chromium",
    "e2e:attendance:stop": "docker compose -p learnspace-attendance-e2e -f compose.e2e.yaml down --volumes --remove-orphans",
    "e2e:attendance": "sh scripts/e2e-attendance.sh",
    "db:backup": "sh scripts/db-backup.sh",
    "db:restore": "sh scripts/db-restore.sh",
    "openapi:generate": "npm run openapi:generate -w @learnspace/api",
    "openapi:check": "npm run openapi:check -w @learnspace/api",
    "db:import": "npm run db:import -w @learnspace/api --",
    "db:import:prepare-local": "tsx scripts/prepare-local-import-rehearsal.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "prisma": "6.12.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "@prisma/client": "6.12.0"
  }
}
