{
  "name": "@learnspace/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm run build -w @learnspace/contracts && npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "npm run build -w @learnspace/contracts && npm run prisma:generate",
    "test": "vitest --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "pretypecheck": "npm run build -w @learnspace/contracts && npm run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "prisma validate --schema ../../prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema ../../prisma/schema.prisma",
    "db:seed": "tsx ../../prisma/seed.ts",
    "db:seed:e2e": "tsx ../../prisma/e2e-seed.ts",
    "openapi:generate": "tsx src/openapi.ts",
    "openapi:check": "vitest run test/openapi.test.ts"
  },
  "dependencies": {
    "@learnspace/contracts": "*",
    "@prisma/client": "6.12.0",
    "express": "^4.21.2",
    "jose": "^6.2.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.2",
    "prisma": "6.12.0",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.8"
  }
}
