{
  "name": "@learnspace/api",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm run build -w @learnspace/contracts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "pretest": "npm run build -w @learnspace/contracts",
    "test": "vitest",
    "pretypecheck": "npm run build -w @learnspace/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@learnspace/contracts": "*",
    "express": "^4.21.2",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.0.8"
  }
}
