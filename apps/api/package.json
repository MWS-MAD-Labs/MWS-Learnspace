{
  "name": "@learnspace/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "dist/application/server.js",
  "scripts": {
    "prebuild": "bun run --filter @learnspace/contracts build && bun run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun --env-file=../../.env --watch src/application/server.ts",
    "start": "bun dist/application/server.js",
    "pretest": "bun run --filter @learnspace/contracts build && bun run prisma:generate",
    "test": "vitest run --exclude 'src/test/integration/**'",
    "test:integration": "vitest run src/test/integration --maxWorkers=1",
    "pretypecheck": "bun run --filter @learnspace/contracts build && bun run prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:validate": "bun src/application/prisma-cli.ts validate --schema ../../prisma/schema.prisma",
    "prisma:generate": "bun src/application/prisma-cli.ts generate --schema ../../prisma/schema.prisma",
    "db:migrate:dev": "bun src/application/prisma-cli.ts migrate dev --schema ../../prisma/schema.prisma",
    "db:migrate:deploy": "bun src/application/prisma-cli.ts migrate deploy --schema ../../prisma/schema.prisma",
    "db:migrate:status": "bun src/application/prisma-cli.ts migrate status --schema ../../prisma/schema.prisma",
    "db:seed": "bun ../../prisma/seed.ts",
    "db:seed:e2e": "bun ../../prisma/e2e-seed.ts",
    "openapi:generate": "bun src/application/openapi.ts",
    "openapi:check": "vitest run openapi.test.ts",
    "db:import": "bun src/application/importer-cli.ts",
    "db:backfill-central-principals": "bun src/application/external-principal-backfill-cli.ts",
    "central-access:sync": "bun src/application/central-access-sync-cli.ts",
    "central-academic:sync": "bun src/application/central-academic-sync-cli.ts",
    "central-student:sync": "bun src/application/central-student-sync-cli.ts",
    "permissions:check": "bun src/application/permissions-cli.ts check",
    "permissions:sync": "bun src/application/permissions-cli.ts sync",
    "shared-session:readiness": "bun src/application/shared-session-readiness-cli.ts"
  },
  "dependencies": {
    "@learnspace/contracts": "*",
    "@hono/node-server": "^1.19.6",
    "@prisma/client": "6.12.0",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "mws-central-auth": "github:MWS-MAD-Labs/mws-central-auth#v0.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/supertest": "^6.0.2",
    "prisma": "6.12.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "^3.0.8"
  }
}
